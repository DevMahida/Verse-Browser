{
  "name": "project-ai-browser",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "desktop": "concurrently -k \"npm run dev\" \"wait-on http-get://localhost:3000 && npm run electron\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.verse.browser",
    "productName": "Verse Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.15.0",
    "google-auth-library": "^10.9.0",
    "html-to-docx": "^1.8.0",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "next": "16.2.10",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
